PORT=3001
DATABASE_URL="postgresql://user:password@localhost:5432/pokemon_tcg"
NODE_ENV=development

# Image hosting (optional — leave unset to use the pokemontcg.io CDN)
# Local: set both. IMAGES_DIR = where download-images.ts wrote the files.
# Cloud: only set IMAGES_BASE_URL (pointing to your bucket). No IMAGES_DIR needed.
IMAGES_DIR=../../../packages/db/public/images
IMAGES_BASE_URL=http://localhost:3001/images
